# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.eggs/
*.egg-info/
*.egg

# =========================
# Virtual environments
# =========================
.venv/
venv/
ENV/
env/

# =========================
# IDE / Editor
# =========================
.idea/
.vscode/
*.swp
*.swo
*~

# =========================
# macOS
# =========================
.DS_Store
.AppleDouble
.LSOverride

# =========================
# Project outputs (never commit)
# =========================
debug/
out/

# =========================
# STL policy
# =========================

# Ignore all STL files by default
*.stl

# Allow specific, intentional STL locations
!refs/*.stl
!tests/fixtures/*.stl
!samples/*.stl
!examples/**/*.stl

# But still ignore generated example outputs if needed
examples/before_after/output/*.stl

# =========================
# Pytest / coverage
# =========================
.pytest_cache/
.coverage
htmlcov/

# =========================
# Misc
# =========================
*.log
.env
.env.local

